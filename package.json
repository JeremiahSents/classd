{
  "name": "classd",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --clear",
    "android": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android --clear",
    "ios": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios --clear",
    "web": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web --clear",
    "start:emulator": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_PUBLIC_USE_EMULATOR=1 expo start --clear",
    "emulators": "node scripts/emulators.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "eas:login": "eas login",
    "eas:preview": "eas update --branch preview --message Preview",
    "eas:build:preview": "eas build --platform all --profile preview",
    "eas:android": "eas build --platform android --profile production",
    "eas:ios": "eas build --platform ios --profile production",
    "eas:update": "eas update --branch production",
    "eas:submit:android": "eas submit --platform android --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-classd \"node --test tests/rules/firestore.rules.test.mjs\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react-native": "^1.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "^57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.14.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "~19.2.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
