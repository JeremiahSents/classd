rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Owner (admin who created it), the assigned class rep, or any admin.
    function canManageClass(classId) {
      let c = get(/databases/$(database)/documents/classes/$(classId)).data;
      return request.auth != null
             && (c.ownerId == request.auth.uid
                 || c.classRepId == request.auth.uid
                 || isAdmin());
    }

    match /users/{uid} {
      // a user reads their own profile; admins can read anyone (to list members)
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;

      // a user's own task-completion records
      match /completions/{taskId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) &&
          request.resource.data.keys().hasOnly(["completedAt"]) &&
          request.resource.data.keys().hasAll(["completedAt"]) &&
          isRecentTimestamp(request.resource.data.completedAt);
        allow delete: if isSelf(uid);
      }
    }

    function isGroupMember(groupId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/groups/$(groupId)/groupMembers/$(request.auth.uid));
    }

    // Collection-group read of member docs: a user may read their OWN membership
    // records across all classes. This authorizes the collectionGroup("members")
    // query in listClasses (a path-nested rule does not cover group queries).
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // codes/{code}
    // Signed-in users can get one code document by its exact 6-digit id, but
    // cannot list all join codes.
    match /codes/{code} {
      allow get: if isSignedIn() && validCode(code);
      allow list: if false;
      allow create: if isSignedIn() && validCodeDoc(code, request.resource.data);
      allow update, delete: if false;
    }

    // Same idea for project-group membership (listMyGroups).
    match /{path=**}/groupMembers/{memberId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // classes/{classId}
    match /classes/{classId} {
      // any signed-in user can read a class (to view it or join by code)
      allow read: if request.auth != null;
      // the creator sets themselves as owner (admins create classes)
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      // owner or admin can edit/delete (e.g. assign class rep)
      allow update, delete: if request.auth != null
                            && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /members/{memberId} {
        allow read: if request.auth != null;
        // a user can add themselves (join); the owner/admin can add anyone.
        // joining must be as a regular student — never self-assigned classRep.
        allow create: if request.auth != null
                      && ((memberId == request.auth.uid
                           && request.resource.data.role == "student")
                          || canManageClass(classId));
        // only the class owner or an admin changes a member's per-class role
        // (rep assignment) — a rep cannot reassign repship themselves
        allow update: if request.auth != null
                      && (get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid
                          || isAdmin());
        // a user can remove themselves (leave); the owner/admin can remove anyone
        allow delete: if request.auth != null
                      && (memberId == request.auth.uid || canManageClass(classId));
      }

      // tasks & announcements: anyone signed in can read; the class rep,
      // owner, or an admin can write.
      match /tasks/{taskId} {
        allow read: if request.auth != null;
        allow write: if canManageClass(classId);
      }

      match /announcements/{announcementId} {
        allow read: if request.auth != null;
        allow write: if canManageClass(classId);
      }
    }

    // Project groups — any signed-in user can create/read; group members manage tasks.
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.createdBy == request.auth.uid;

      match /groupMembers/{memberId} {
        allow read: if request.auth != null;
        // a user joins/leaves themselves
        allow create, delete: if request.auth != null && memberId == request.auth.uid;
      }

      match /tasks/{taskId} {
        allow read: if request.auth != null;
        // only members of the group can create/assign/update group tasks
        allow write: if isGroupMember(groupId);
      }
    }
  }
}
