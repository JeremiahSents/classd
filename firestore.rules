rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Owner (admin who created it), the assigned class rep, or any admin.
    function canManageClass(classId) {
      let c = get(/databases/$(database)/documents/classes/$(classId)).data;
      return signedIn()
             && (c.ownerId == request.auth.uid
                 || c.classRepId == request.auth.uid
                 || isAdmin());
    }

    // Enrolled in the class (has a members/{uid} doc).
    function isClassMember(classId) {
      return signedIn()
             && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    function canReadClass(classId) {
      return isClassMember(classId) || canManageClass(classId);
    }

    function isGroupMember(groupId) {
      return signedIn()
             && exists(/databases/$(database)/documents/groups/$(groupId)/groupMembers/$(request.auth.uid));
    }

    match /users/{uid} {
      // a user reads their own profile; admins can read anyone (to list members)
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // sign-up always creates a student — admins are promoted in the console
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == "student"
                    && request.resource.data.keys().hasOnly(
                         ["name", "email", "role", "avatarUrl", "createdAt"]);
      // a user edits their own profile, but never their role or email
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                         ["name", "avatarUrl", "expoPushTokens", "notificationPrefs"]);
      // account deletion runs server-side (deleteAccount Cloud Function)
      allow delete: if false;

      // a user's own task-completion records
      match /completions/{taskId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Collection-group read of member docs: a user may read their OWN membership
    // records across all classes. This authorizes the collectionGroup("members")
    // query in listClasses (a path-nested rule does not cover group queries).
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Same idea for project-group membership (listMyGroups).
    match /{path=**}/groupMembers/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /classes/{classId} {
      // members and managers read a class; admins can list them all. Students
      // never list classes — joining by code runs in the joinClass function,
      // so join codes can't be scraped.
      allow read: if isAdmin() || canReadClass(classId);
      // only admins create classes, as their owner
      allow create: if isAdmin()
                    && request.resource.data.ownerId == request.auth.uid;
      // owner or admin can edit/delete (assign class rep, new join code, delete)
      allow update, delete: if signedIn()
                            && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /members/{memberId} {
        allow read: if canReadClass(classId);
        // students join through the joinClass function; managers can add anyone
        allow create: if canManageClass(classId)
                      && request.resource.data.uid == memberId;
        // only the class owner or an admin changes a member's per-class role
        // (rep assignment) — a rep cannot reassign repship themselves
        allow update: if signedIn()
                      && (get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid
                          || isAdmin());
        // a user can remove themselves (leave); a manager can remove anyone
        allow delete: if signedIn()
                      && (memberId == request.auth.uid || canManageClass(classId));
      }

      // tasks & announcements: class members read; the class rep, owner, or an
      // admin writes.
      match /tasks/{taskId} {
        allow read: if canReadClass(classId);
        allow write: if canManageClass(classId);
      }

      match /announcements/{announcementId} {
        allow read: if canReadClass(classId);
        allow write: if canManageClass(classId);
      }
    }

    // Project groups — class members create them; the creator renames/deletes;
    // group members manage group tasks.
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && isClassMember(request.resource.data.classId);
      allow update: if signedIn()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]);
      // subcollections are cleaned up by the onGroupDeleted function
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /groupMembers/{memberId} {
        allow read: if signedIn();
        // a user joins/leaves themselves, and only groups in their own classes
        allow create: if signedIn()
                      && memberId == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && isClassMember(get(/databases/$(database)/documents/groups/$(groupId)).data.classId);
        allow delete: if signedIn() && memberId == request.auth.uid;
      }

      match /tasks/{taskId} {
        allow read: if signedIn();
        // only members of the group can create/assign/update group tasks
        allow write: if isGroupMember(groupId);
      }
    }

    // Reminder de-dupe markers — Cloud Functions only.
    match /sentNotifications/{markerId} {
      allow read, write: if false;
    }

    // Failed join-code attempts, for rate limiting — Cloud Functions only.
    match /joinAttempts/{uid} {
      allow read, write: if false;
    }
  }
}
