rules_version = '2';

// Class materials live at classes/{classId}/materials/{fileName}. Access mirrors
// firestore.rules: class members read; the class rep, owner, or an admin
// uploads and deletes.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function canManageClass(classId) {
      let c = firestore.get(/databases/(default)/documents/classes/$(classId)).data;
      return c.ownerId == request.auth.uid
             || c.classRepId == request.auth.uid
             || isAdmin();
    }

    function isClassMember(classId) {
      return firestore.exists(/databases/(default)/documents/classes/$(classId)/members/$(request.auth.uid));
    }

    match /classes/{classId}/materials/{fileName} {
      allow read: if request.auth != null
                  && (isClassMember(classId) || canManageClass(classId));
      // 25 MB cap per file
      allow create: if request.auth != null
                    && canManageClass(classId)
                    && request.resource.size < 25 * 1024 * 1024;
      allow delete: if request.auth != null && canManageClass(classId);
    }
  }
}
